
extends layout

block content
	- const pvnFlows = ['pvn_ip', 'pvn_ip_plus', 'pvn_im', 'pvn_ipificator', 'pvn_sim'];
	- const loginFlows = ['login_ip', 'login_ip_plus', 'login_im', 'login_sim'];
	- const identityFlows = ['anonymous', 'kyc_phone'];
	- const hasPvnButtons = pvnFlows.some(flow => clients.find(c => c.user_flow === flow));
	- const hasLoginButtons = loginFlows.some(flow => clients.find(c => c.user_flow === flow));
	- const hasIdentityButtons = identityFlows.some(flow => clients.find(c => c.user_flow === flow));
	- const firstVisibleTab = hasPvnButtons ? 'pnv' : (hasLoginButtons ? 'login' : (hasIdentityButtons ? 'identity' : 'pnv'));

	.container.d-flex.h-100.w-100.mx-auto.flex-column
		main
			#login.center-vertical
				div.form-login
					.clearfix
					.row.block-header
						.col-12
							.row
								h3.app-name IPification features showcase

								select(id="select" value=node_env data-env=node_env)
									option(data-selected="stage" selected=node_env == "stage" value=stage_url) Stage
									option(data-selected='live' selected=node_env == "live" value=live_url) Live
									if live_id_url
										option(data-selected='live_id' selected=node_env == "live_id" value=live_id_url) Live ID
					.row.block-page
						ul.list-tabs.nav.nav-tabs
							if hasPvnButtons
								li.nav-item
									a.nav-link.nav-link-pnv(href="#pnv" onClick="select_nav('pnv')" class=firstVisibleTab === 'pnv' ? 'active' : '') PNV
							if hasLoginButtons
								li.nav-item
									a.nav-link.nav-link-login(href="#login" onClick="select_nav('login')" class=firstVisibleTab === 'login' ? 'active' : '') Login
							if hasIdentityButtons
								li.nav-item
									a.nav-link.nav-link-identity(href="#identity" onClick="select_nav('identity')" class=firstVisibleTab === 'identity' ? 'active' : '') Identity

						.col-12.row-item
							if hasPvnButtons
								.block-button.block.block-pnv.block-1#pnv(class=firstVisibleTab === 'pnv' ? 'active' : '')
									p.description_title Phone Number Verification
									p.description Verify phone number through IP or IM auth.
									.div(style="margin-top: 15px")
										.row
											.col
												input.form-control.phoneNumber(type='text' name='phone' id='phone')
												each flow in pvnFlows
													- const client = clients.find(c => c.user_flow === flow);
													if client
														if flow === 'pvn_ip'
															button.btn_full.btn.btn_phone.btn-active.btnLoginPhone.btn-user-flow#pvn_ip(data-title=get_flow_title('pvn_ip', 'IP Phone Number Verification') data-user-flow='pvn_ip') IP
																span.right-icon
														else if flow === 'pvn_ip_plus'
															button.btn_full.btn.btn_phone.btn-active.btnLoginPhone.btn-user-flow#pvn_ip_plus(data-title=get_flow_title('pvn_ip_plus', 'IP+ Phone Number Verification') data-user-flow='pvn_ip_plus') IP+
																span.right-icon
														else if flow === 'pvn_im'
															button.btn_full.btn.btn_IM.btnLoginPhone.btn-user-flow#pvn_im(data-title=get_flow_title('pvn_im', 'IM Phone Number Verification') data-user-flow='pvn_im') IM
																span.right-icon
														else if flow === 'pvn_ipificator'
															button.btn_full.btn.btn_IM.btnLoginPhone.btn-user-flow#pvn_ipificator(data-title=get_flow_title('pvn_ipificator', 'IP via App') data-user-flow='pvn_ipificator', style="display: none") IP via App
																span.right-icon
														else if flow === 'pvn_sim'
															button.btn_full.btn.btn_IM.btnLoginPhone.btn-user-flow#pvn_sim(data-title=get_flow_title('pvn_sim', 'SIM') data-user-flow='pvn_sim') SIM
																span.right-icon

							if hasLoginButtons
								.block-button.block-login.block.block-2#login(class=firstVisibleTab === 'login' ? 'active' : '')
									p.description_title Quick Access
									p.description.description_helper Login through IP or IM auth with phone number sharing.
									each flow in loginFlows
										- const client = clients.find(c => c.user_flow === flow);
										if client
											if flow === 'login_ip'
												button.btn_full_blue.btn_instant.btn-user-flow#login_ip(type='button' data-title=get_flow_title('login_ip', 'IP Login') data-user-flow='login_ip')
													span.right-icon
													span IP
											else if flow === 'login_ip_plus'
												button.btn_full_blue.btn_instant.btn-user-flow#login_ip_plus(type='button' data-title=get_flow_title('login_ip_plus', 'IP+ Login') data-user-flow='login_ip_plus')
													span.right-icon
													span IP+
											else if flow === 'login_im'
												button.btn_full_blue.btn-user-flow#login_im(type='button' data-title=get_flow_title('login_im', 'IM Login') data-user-flow='login_im')
													span.right-icon
													span IM
											else if flow === 'login_sim'
												button.btn_full_blue.btn-user-flow#login_sim(type='button' data-title=get_flow_title('login_sim', 'SIM') data-user-flow='login_sim')
													span.right-icon
													span SIM

							if hasIdentityButtons
								.block-button.block.block-identity.block-1#identity(class=firstVisibleTab === 'identity' ? 'active' : '')
									p.description_title Mobile ID & Know Your Customer
									p.description.description_helper Identify user with anonymous identity (mobile_id) or obtain user info with KYC.
									- const anonymousClient = clients.find(c => c.user_flow === 'anonymous');
									if anonymousClient
										button.btn_full_blue.btn_instant.btn-user-flow#anonymous(type='button' data-title=get_flow_title('anonymous', 'Anonymous Identity') style="margin-bottom:59px" data-user-flow='anonymous')
											span.right-icon.right-icon-blue
											span Anonymous Identity
									- const kycClient = clients.find(c => c.user_flow === 'kyc_phone');
									if kycClient
										.div
											input.form-control.phoneNumber(type='text' name='phone_kyc' id='phone_kyc')
											button.btn_full.btn.btn_kyc.btnLoginPhone.btn-user-flow#kyc_phone(data-title=get_flow_title('kyc_phone', 'KYC Data')  type='button' data-user-flow='kyc_phone') KYC
												span.right-icon

		footer(class="mt-auto")
			.viettel-legal
				| Please be kindly aware that by operating to initiate and/or access user accounts, you have agreed on entire content set out in the Privacy terms and Conditions of the Service; and Terms of Use by
				a(href="#" style="margin-left: 4px; margin-right: 4px;" onclick="showConsentPage()") <b>Viettel</b>
				| in case you are Viettel subscribers.
			.privacy-link
				a(href="https://www.ipification.com/legal" target='_blank')
					| Privacy Policy
				span.info-icon
					| About
				a(href="javascript:void(0)" id="help")
					| Help

	#app_info.modal(tabindex="-1" role="dialog")
		.modal-dialog
			.modal-content(style="border-radius: 0px;")
				.modal-header
					h5.modal-title About this demo
					button.close(type='button' data-dismiss='modal' aria-label='Close')
						span(aria-hidden='true').right-icon
				.modal-body
					div.mb-3
						strong server
						p #{auth_server_url}
					div.mb-3
						strong state
						p #{state}
					.developer-link
						a(href="https://developer.ipification.com/#/")
							| Developer.ipification

	#input_alert.error-popup.modal(tabindex="-1" role="dialog")
		.modal-dialog
			.modal-content(style="border-radius: 0px;")
				.modal-header
					h6.modal-title Please enter phone number

	#phone_invalid_alert.error-popup.modal(tabindex="-1" role="dialog")
		.modal-dialog
			.modal-content(style="border-radius: 0px;")
				.modal-header
					h6.modal-title Your phone is invalid

	.wrapper-loader
		span.loader
			span.loader-inner

	if error_message
		#error_alert.modal(tabindex="-1" role="dialog")
			.modal-dialog
				.modal-content(style="border-radius: 0px;")
					.modal-header
						h6.modal-title #{error_message}

block head_scripts
	script(type="text/javascript").
		var base_url = "!{baseUrl}";
